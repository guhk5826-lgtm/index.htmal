for(let i=0;i<14;i++){const b=document.createElement('div');b.className='bub';const z=Math.random()*26+8;b.style.cssText='left:'+Math.random()*100+'%;width:'+z+'px;height:'+z+'px;animation-duration:'+(12+Math.random()*14)+'s;animation-delay:-'+Math.random()*20+'s';document.body.appendChild(b)}
let lt=0;addEventListener('pointermove',e=>{const n=performance.now();if(n-lt<70)return;lt=n;const d=document.createElement('div');d.className='sparkle';d.style.left=e.clientX+'px';d.style.top=e.clientY+'px';document.body.appendChild(d);setTimeout(()=>d.remove(),800)});
</script>
</body>
